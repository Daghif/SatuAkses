# =====================================================================
# SatuAkses — Environment Configuration
# =====================================================================
# METODE AUTENTIKASI GEMINI (Pilih salah satu yang paling mudah):
# ---------------------------------------------------------------------
# Opsi 1 (Paling Mudah & Rekomendasi): Gunakan API Key dari Google AI Studio
# Ambil gratis di https://aistudio.google.com/app/apikey (tanpa perlu install gcloud CLI)
GEMINI_API_KEY=your_gemini_api_key_here

# Opsi 2: Service Account JSON dari Google Cloud Console
# Letakkan file json di folder project dan isi path-nya:
# GOOGLE_APPLICATION_CREDENTIALS=service_account_key.json

# Opsi 3: Vertex AI via Google Cloud Project + Application Default Credentials (ADC)
# Jika memakai gcloud CLI: jalankan 'gcloud auth application-default login'
GOOGLE_CLOUD_PROJECT=hackcathon-primestep-11
GOOGLE_CLOUD_LOCATION=us-central1

# =====================================================================
# Server & Browser Automation Settings
# =====================================================================
PORT=8000
PLAYWRIGHT_HEADLESS=true
